# Replace every placeholder before using this on a real host.

# Linkding can create an initial superuser on first start.
LD_SUPERUSER_NAME=replace-me
LD_SUPERUSER_PASSWORD=replace-me-with-a-long-random-password

# Keep this aligned with the external URL if you put a reverse proxy in front.
LD_CSRF_TRUSTED_ORIGINS=https://bookmarks.example.test
